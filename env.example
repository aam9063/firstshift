# FirstShift environment. Copy this file to .env and fill in real values.
#   cp env.example .env
# Never commit .env.

# OpenAI (agents, configurable; default gpt-4.1-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Twilio WhatsApp channel: sandbox subaccount (twilio-channel, S2). Twilio is
# shared with another project, so separation happens through a SUBACCOUNT:
# create the subaccount in the Twilio console, then create an API Key inside
# it. TWILIO_ACCOUNT_SID is the subaccount SID (AC...), the API key (SK...)
# signs REST sends, and TWILIO_AUTH_TOKEN is the subaccount auth token used to
# validate inbound webhook signatures. Credits draw from the parent account;
# each subaccount has its own WhatsApp sandbox and join code.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Inbound signature validation (S5): on by default whenever TWILIO_AUTH_TOKEN
# is set; set to false only for local curl experiments, never in a tunnel.
TWILIO_VALIDATE_SIGNATURE=

# Langfuse (self-hosted at http://localhost:3000; create the keys in its UI)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# Sentry error tracking (SaaS or self-hosted DSN; empty disables the SDK)
SENTRY_DSN=

# Grafana admin (http://localhost:3001)
GRAFANA_ADMIN_PASSWORD=admin
