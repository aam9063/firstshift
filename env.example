# FirstShift environment. Copy this file to .env and fill in real values.
#   cp env.example .env
# Never commit .env.

# OpenAI (agents, configurable; default gpt-4.1-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Twilio WhatsApp channel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Langfuse (self-hosted at http://localhost:3000; create the keys in its UI)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# Sentry error tracking (SaaS or self-hosted DSN; empty disables the SDK)
SENTRY_DSN=

# Grafana admin (http://localhost:3001)
GRAFANA_ADMIN_PASSWORD=admin
